# Local development only. EAS builds and updates take these from eas.json /
# the GitHub environment, never from this file. EXPO_PUBLIC_* values are
# compiled into the JavaScript bundle — never put a secret here.
#
# Leave both unset to talk to a backend on port 3000 of the machine running
# Metro (the app derives its LAN address, so a phone on the same Wi-Fi works).

# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api
# EXPO_PUBLIC_WS_URL=http://192.168.1.50:3000

# Point a local run at beta instead:
# EXPO_PUBLIC_API_URL=https://beta.service.bloomboard.pro/api
# EXPO_PUBLIC_WS_URL=https://beta.service.bloomboard.pro
