{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "beta",
      "env": {
        "APP_ENV": "preview",
        "EXPO_PUBLIC_API_URL": "https://beta.service.bloomboard.pro/api",
        "EXPO_PUBLIC_WS_URL": "https://beta.service.bloomboard.pro"
      }
    },
    "beta": {
      "autoIncrement": true,
      "channel": "beta",
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "APP_ENV": "beta",
        "EXPO_PUBLIC_API_URL": "https://beta.service.bloomboard.pro/api",
        "EXPO_PUBLIC_WS_URL": "https://beta.service.bloomboard.pro"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://service.bloomboard.pro/api",
        "EXPO_PUBLIC_WS_URL": "https://service.bloomboard.pro"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "beta": {
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "android": {
        "track": "production",
        "releaseStatus": "draft"
      }
    }
  }
}
